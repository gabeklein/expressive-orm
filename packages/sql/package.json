{
  "name": "@expressive/sql",
  "version": "0.4.4",
  "description": "SQL toolkit and embedded SQLite store for Expressive ORM.",
  "license": "ISC",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "Gabe Klein",
    "email": "gabe@expressive.dev",
    "url": "https://github.com/gabeklein"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit --incremental",
    "coverage": "vitest run --coverage",
    "test": "bun run typecheck && bun run coverage"
  },
  "dependencies": {
    "@expressive/orm": "workspace:^",
    "sql-formatter": "^10.7.2"
  },
  "devDependencies": {
    "@expressive/mvc": "^0.88.0",
    "tsdown": "^0.20.1"
  },
  "peerDependencies": {
    "@expressive/mvc": "^0.88.0",
    "@libsql/client": ">=0.5.0",
    "better-sqlite3": ">=11.0.0",
    "sqlite3": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@libsql/client": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "sqlite3": {
      "optional": true
    }
  }
}
