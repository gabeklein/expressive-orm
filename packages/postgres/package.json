    "pglite",
    "live",
    "entity",
    "reactive",
    "expressive"
  ],
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabeklein/expressive-orm.git",
    "directory": "packages/postgres"
  },
  "homepage": "https://github.com/gabeklein/expressive-orm/tree/main/packages/postgres#readme",
  "bugs": {
    "url": "https://github.com/gabeklein/expressive-orm/issues"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "Gabe Klein",
    "email": "gabe@expressive.dev",
    "url": "https://github.com/gabeklein"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
