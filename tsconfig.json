{
    "compilerOptions": {
        "baseUrl": ".",
        "esModuleInterop": true,
        "lib": ["ES2020", "ES2021.WeakRef"],
        "moduleResolution": "bundler",
        "noUnusedLocals": true,
        "sourceMap": true,
        "skipLibCheck": true,
        "module": "ESNext",
        "strict": true,
        "target": "ES2020",
        "types": ["node"],
        "paths": {
            "@expressive/orm/driver": [
              "packages/orm/src/driver"
            ],
            "@expressive/*": [
              "packages/*/src"
            ]
        }
    },
    "exclude": [
      "**/node_modules",
      "**/dist"
    ]
}