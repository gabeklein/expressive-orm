{
	"name": "expressive-orm",
	"license": "ISC",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "bun run --filter='./packages/*' build",
		"typecheck": "bun run --filter='./packages/*' typecheck",
		"coverage": "bun run --filter='./packages/*' coverage",
		"test": "bun run --filter='./packages/*' test",
		"changeset": "changeset",
		"ci:version": "changeset version && bun install",
		"ci:publish": "bun run --filter='./packages/*' build && changeset publish",
		"nuke": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^0.7.0",
		"@changesets/cli": "^2.27.12",
		"@types/node": "^18.19.0",
		"@vitest/coverage-istanbul": "^4.1.10",
		"tslib": "^2.3.0",
		"typescript": "^5.8.2",
		"vitest": "^4.1.10"
	},
	"engines": {
		"node": "^20.19.0 || ^22.12.0 || >=24.0.0"
	},
	"packageManager": "bun@1.3.14"
}
